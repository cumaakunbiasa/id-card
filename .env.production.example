APP_NAME="Sistem Pengajuan ID Card"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://izin.example.com
# Keep UTC for existing installations unless historical timestamps are migrated.
APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=izin_kerja
DB_USERNAME=izin_app
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
# Configure SMTP before offering password reset to real users.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=idmitrakerja@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=idmitrakerja@gmail.com
MAIL_FROM_NAME="Sistem Pengajuan ID Card"
VITE_APP_NAME="${APP_NAME}"

MAIL_SCHEME=smtp

MAIL_URL=
